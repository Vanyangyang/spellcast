{
  "name": "orbit-board",
  "displayName": "Spellcast 专注板",
  "description": "侧栏是入口。展开后是专注板：空间碎片的呈现面，不是聊天窗。",
  "version": "0.1.1",
  "publisher": "orbit",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orbit",
          "title": "Spellcast",
          "icon": "media/orbit.svg"
        }
      ]
    },
    "views": {
      "orbit": [
        {
          "type": "webview",
          "id": "orbit.environment",
          "name": "专注板"
        }
      ]
    },
    "commands": [
      {
        "command": "orbit.expand",
        "title": "Spellcast: 展开专注板"
      },
      {
        "command": "orbit.scatter",
        "title": "Spellcast: 把选区丢上板"
      },
      {
        "command": "orbit.importFile",
        "title": "Spellcast: 把当前文件当对话导入"
      },
      {
        "command": "orbit.openExternal",
        "title": "Spellcast: 在浏览器打开整块板"
      }
    ],
    "configuration": {
      "title": "Spellcast",
      "properties": {
        "orbit.environmentUrl": {
          "type": "string",
          "default": "http://127.0.0.1:47193",
          "description": "专注板地址。本机先跑 npm start（47193）与后端（47194）。"
        }
      }
    }
  }
}
