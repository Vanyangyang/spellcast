{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spellcast",
  "version": "0.4.9",
  "identifier": "com.spellcast.board",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite.mjs",
    "devUrl": "http://127.0.0.1:47193",
    "beforeBuildCommand": "node scripts/prepare-codex-plugin-resource.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Spellcast",
        "width": 1320,
        "height": 860,
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "resources": ["resources/codex-plugin/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
